# Limpiar todo
rm(list = ls())
# Librer?as
library(ggplot2)
library(dplyr)
library(stringr)
library(cowplot)
library(magick)
library(ggtext)
library(googlesheets4)
# Fuentes
library(showtext)
font_add_google("Source Sans 3", "font_sans")
font_add_google("Source Serif 4", "font_serif")
showtext_auto()
# Leer datos
Raw <- read_sheet(ss = "https://docs.google.com/spreadsheets/d/1Cfbecjc5DLo3uGsMEHscsfUC9YOtnKtFvt1bOZI_B4c/edit?usp=sharing",
sheet = "Tipo")
Data <- Raw %>%
filter(Año == 2025, Tipo != "Sin especificar") %>%
group_by(Año, Tipo) %>%
summarise(Cantidad = sum(Frecuencia)) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
ungroup()
Data <- Data %>%
filter(Tipo != "Otras") %>%
arrange(desc(Porcentaje)) %>%
mutate(xpos = c(1, 2, 1)) %>%
rbind(c(Data %>% filter(Tipo == "Otras"), xpos=2)) %>%
mutate(ypos = rep(2:1, each=2))
unique(Raw$Tipo)
Data <- Raw %>%
filter(Año == 2025, Tipo != "Sin especificar") %>%
group_by(Año, Tipo) %>%
summarise(Cantidad = sum(Frecuencia)) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
ungroup()
Data <- Data %>%
filter(Tipo != "Otros") %>%
arrange(desc(Porcentaje)) %>%
mutate(xpos = c(1, 2, 1, 2)) %>%
rbind(c(Data %>% filter(Tipo == "Otros"), xpos=1.5)) %>%
mutate(ypos = c(3, 2, 3, 2, 1))
Data <- Raw %>%
filter(Año == 2025, Tipo != "Sin especificar") %>%
group_by(Año, Tipo) %>%
summarise(Cantidad = sum(Frecuencia)) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
ungroup()
View(Data)
Data <- Data %>%
filter(Tipo != "Otros") %>%
arrange(desc(Porcentaje)) %>%
mutate(xpos = c(1, 2, 1, 2))
Data <- Data %>%
filter(Tipo != "Otros") %>%
arrange(desc(Porcentaje))
Data <- Raw %>%
filter(Año == 2025, Tipo != "Sin especificar") %>%
group_by(Año, Tipo) %>%
summarise(Cantidad = sum(Frecuencia)) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
ungroup()
Data <- Data %>%
filter(Tipo != "Otros") %>%
arrange(desc(Porcentaje)) %>%
mutate(xpos = c(1, 2, 1, 2, 1)) %>%
rbind(c(Data %>% filter(Tipo == "Otros"), xpos=2)) %>%
mutate(ypos = rep(3:1, 2))
Data <- Raw %>%
filter(Año == 2025, Tipo != "Sin especificar") %>%
group_by(Año, Tipo) %>%
summarise(Cantidad = sum(Frecuencia)) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
ungroup()
Data <- Data %>%
filter(Tipo != "Otros") %>%
arrange(desc(Porcentaje)) %>%
mutate(xpos = c(1, 2, 1, 2, 1)) %>%
rbind(c(Data %>% filter(Tipo == "Otros"), xpos=2))
View(Raw)
Data <- Raw %>%
filter(Año == 2025, Tipo != "Sin especificar") %>%
group_by(Año, Tipo) %>%
