Data_femicidios %>% group_by(Año) %>% mutate(Tasa = (100000*Femicidio)/Proyeccion_muj) %>% pull(Tasa)
Data_femicidios %>% group_by(Año) %>% mutate(Tasa = (100000*Femicidio)/Proyeccion_muj)
Data_femicidios %>% group_by(Año) %>% summarise(Proyeccion_muj = sum(Proyeccion_muj), Femicidio = sum(Femicidio)) %>% ungroup %>% mutate(Tasa = (100000*Femicidio)/Proyeccion_muj)
View(Tabla)
# Tabla
Tabla <- Data_femicidios %>%
select(name, Femicidio, Tasa) %>%
rename(Provincia = "name", n = "Femicidio") %>%
arrange(desc(Tasa)) %>%
mutate(Tasa = formatC(round(Tasa,2), big.mark=".", decimal.mark = ",")) %>%
top_n(n=10) %>%
mutate(Provincia = ifelse(Provincia == "Salta", "**Salta**", Provincia))
View(Tabla)
