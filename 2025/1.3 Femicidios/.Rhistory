# Crear datos
Data <- data.frame(matrix(c(2014, 318, 503, 821,
2015, 367, 558, 925,
2016, 250, 716, 966,
2017, 290, 870, 1160,
2018, 272, 840, 1112,
2019, 446, 1196, 1642,
2020, 328, 1113, 1441,
2021, 336, 1297, 1633,
2022, 365, 1409, 1774,
2023, 356, 1443, 1799,
2024, 298, 1315, 1613),
nrow=11, byrow=TRUE)) %>%
select(-X4) %>%
rename(Año = X1) %>%
pivot_longer(cols = c(X2, X3), names_to = "Tipo", values_to = "Cantidad") %>%
mutate(Tipo = ifelse(Tipo == "X2", "Violaciones", "Otros delitos contra la integridad sexual"))
View(Data)
