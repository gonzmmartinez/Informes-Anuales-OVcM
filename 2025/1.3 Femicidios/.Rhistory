Data <- data.frame(matrix(c(2014, 318, 503, 821,
2015, 367, 558, 925,
2016, 250, 716, 966,
2017, 290, 870, 1160,
2018, 272, 840, 1112,
2019, 446, 1196, 1642,
2020, 328, 1113, 1441,
2021, 336, 1297, 1633,
