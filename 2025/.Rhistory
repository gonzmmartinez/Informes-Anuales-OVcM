help("match")
Data <- Data0 %>%
filter(Medida != "Otras") %>%
arrange(Año, desc(Cantidad)) %>%
group_by(Año) %>%
mutate(Level = row_number()) %>%
rbind(Data0 %>% filter(Medida == "Otras")) %>%
mutate(Level = ifelse(Medida == "Otras", 15, Level)) %>%
ungroup %>%
mutate(Level = formatC(Level, width=2, flag="0"),
Año = as.character(Año)) %>%
mutate(Axis = case_when(Año == "2023" ~ "**2.023**\n*Todo el año*",
Año == "2024" ~ "**2.024**\n*Todo el año*",
Año == "2025" ~ "**2.025**\n*Primer semestre*"))
match("2023", Data)
View(Data)
