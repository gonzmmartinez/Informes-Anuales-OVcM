left_join(Mes, by="Mes") %>%
filter(Año %in% c(2024,2025), Tipo == "Abuso sexual") %>%
group_by(Mes, Mes_num, Accion) %>%
summarise(Cantidad = sum(Cantidad)) %>%
mutate(Accion = factor(Accion,
