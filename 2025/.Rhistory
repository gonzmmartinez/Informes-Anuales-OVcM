mutate(Porcentaje = Cantidad/sum(Cantidad) * 100) %>%
ungroup %>%
filter(Dia %in% c("Sábado", "Domingo")) %>%
group_by(Año) %>%
summarise(Cantidad = sum(Cantidad),
Porcentaje = sum(Porcentaje)) %>%
pull(Porcentaje)
