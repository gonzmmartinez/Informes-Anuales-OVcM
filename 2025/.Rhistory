# Limpiar todo
rm(list = ls())
# Funciones
`%ni%` <- Negate(`%in%`)
# Librer?as
library(ggplot2)
library(ggbump)
library(dplyr)
library(stringr)
library(cowplot)
library(magick)
library(googlesheets4)
# Fuentes
library(showtext)
font_add_google("Barlow", "font")
showtext_auto()
# Leer datos
Raw <- read_sheet(ss = "https://docs.google.com/spreadsheets/d/1AO8SmJ45quqCCvg9nZ0vZqRLvxZMfAqB7uzOtXmu9Ro/edit?usp=sharing",
sheet = "Medidas")
Data0 <- Raw %>%
group_by(Año, Medida) %>%
summarise(Cantidad = sum(Cantidad)) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
ungroup
Medidas <- Data %>%
filter(Año == 2025) %>%
arrange(desc(Cantidad)) %>%
top_n(15) %>%
pull(Medida)
