# Cargar datos
Raw <- read_sheet(ss = link_ive_ile, sheet = "IVE/ILE_mes")
Data <- Raw %>%
mutate(Cantidad = round(Cantidad, 0)) %>%
mutate(Año_mes = paste0(Mes_ord, "-", str_sub(Año, 3,4)))
# Crear gráfico
grafico <- ggplot(Data, aes(x = Año_mes, y = Cantidad)) +
geom_line(aes(color = Tipo, group = Tipo), linewidth = 2) +
# líneas verticales entre años
geom_vline(data = inicios_año, aes(xintercept = as.numeric(Fecha_inicio)),
color = "gray50", linetype = "dashed") +
geom_text(data = inicios_año, aes(x = Fecha_inicio, y = -25, label = Año),
angle = 90, vjust=1.25, hjust = 0.5, size = 5, color = "gray30") +
scale_y_continuous(labels = function(z) formatC(z, big.mark = ".", decimal.mark=",", format="fg")) +
scale_x_discrete(labels = c(str_to_title(month(1:12, label = TRUE, abbr = TRUE, locale = "es_ES")),
str_to_title(month(1:6, label = TRUE, abbr = TRUE, locale = "es_ES")))) +
labs(x = "Mes", y = "Cantidad") +
scale_color_manual(values=c("#60c04c", "#21917b")) +
theme_light() +
coord_cartesian(ylim = c(-0, 5000), xlim=c(0.75, 48.25), clip="off", expand=FALSE) +
theme(text = element_text(size=20, family="font"),
axis.text.x = element_text(size = 10, angle=45, family="font", margin=margin(t=10,b=0,l=0,r=0)),
axis.text.y = element_text(size=10, family="font"),
axis.title = element_text(size=12, family="font"),
plot.title = element_text(family="font", face="bold"),
plot.subtitle = element_text(size=15, family="font", face="italic"),
plot.caption = element_text(size=12, family="font"),
plot.caption.position = "plot",
strip.background = element_rect(fill="black"),
strip.text = element_text(color="white", family="font", size=15, face="bold"),
panel.grid.minor.x = element_blank(),
panel.spacing.x = unit(0, "line"))
