scale_x_discrete(labels = rep(str_to_title(month(ymd("2000-01-01") + months(0:11), label = TRUE, abbr = TRUE, locale = "es_ES.UTF-8")), 4)) +
labs(x = "Mes", y = "Cantidad") +
scale_color_manual(values=c("#60c04c", "#21917b")) +
theme_light() +
coord_cartesian(ylim = c(-0, 5000), xlim=c(0.75, 48.25), clip="off", expand=FALSE) +
theme(text = element_text(size=20, family="font"),
