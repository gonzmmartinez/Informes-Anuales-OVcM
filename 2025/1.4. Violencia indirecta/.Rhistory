# Cargar datos
Raw <- read_sheet(ss = link_ive_ile, sheet = "IVE/ILE_mes")
# Librerías
library(dplyr)
library(ggplot2)
library(stringr)
library(readr)
library(tidyr)
library(googlesheets4)
library(lubridate)
# Fuentes
library(showtext)
font_add_google("Barlow", "font")
showtext_auto()
# Plantilla
link_ive_ile <- "https://docs.google.com/spreadsheets/d/1nnUI0CDjmjEg9KYtft80CXVX9QX0ub4N3l9-ttiULV8/edit?usp=sharing"
# Cargar datos
Raw <- read_sheet(ss = link_ive_ile, sheet = "IVE/ILE_mes")
Data <- Raw %>%
mutate(Cantidad = round(Cantidad, 0)) %>%
mutate(Año_mes = paste0(str_sub(Año, 3,4), "-", formatC(Mes_ord, width = 2, flag = "0")))
Data %>% group_by(Año) %>% summarise(Cantidad = sum(Cantidad))
Data %>% group_by(Año) %>% summarise(Cantidad = sum(Cantidad)) %>% pull(Cantidad)
mean(Data %>% group_by(Año) %>% summarise(Cantidad = sum(Cantidad)) %>% pull(Cantidad))
mean(Data %>% filter(Tipo == "IVE") %>% group_by(Año) %>% summarise(Cantidad = sum(Cantidad)) %>% pull(Cantidad))
Data %>% filter(Tipo == "IVE") %>% group_by(Año) %>% summarise(Cantidad = sum(Cantidad)) %>% pull(Cantidad)
