# Limpiar todo
rm(list = ls())
# Librerias
library(openxlsx)
library(dplyr)
library(ggplot2)
library(sf)
library(ggspatial)
library(cowplot)
library(showtext)
library(stringr)
# Fuentes
library(showtext)
font_add_google("Fira Sans", "font")
showtext_auto()
# Cargar shape
Mapa_Salta <- st_read(paste0(dirname(rstudioapi::getActiveDocumentContext()$path), "/Datos/Salta_munic_shape/Salta_shape.shp"))
# Cargar datos
Data <- read.csv(paste0(dirname(rstudioapi::getActiveDocumentContext()$path), "/Datos/Mapa_capacitaciones.csv")) %>%
mutate(ID = as.character(ID)) %>%
rename(in1 = "ID")
View(Mapa_Salta)
View(Data)
source("C:/ESTADÍSTICA/INFORMES ANUALES/2026/Resumen ejecutivo/Presencia_capacitaciones.R", echo = TRUE)
source("C:/ESTADÍSTICA/INFORMES ANUALES/2026/Resumen ejecutivo/Presencia_capacitaciones.R", echo = TRUE)
source("C:/ESTADÍSTICA/INFORMES ANUALES/2026/Resumen ejecutivo/Presencia_capacitaciones.R", echo = TRUE)
colnames(Mapa_Salta)
library(ggimage)
install.packages("ggimage")
source("C:/ESTADÍSTICA/INFORMES ANUALES/2026/Resumen ejecutivo/Presencia_capacitaciones.R", echo = TRUE)
Puntos <- Mapa_Salta %>%
filter(Capacitacion == "TRUE") %>%
st_point_on_surface()
Coordenadas <- st_coordinates(Puntos)
Imagenes <- data.frame(
x = Coordenadas[, 1],
y = Coordenadas[, 2],
imagen = Imagen
)
# Grafico
Mapa_cor <- ggplot(Mapa_Salta) +
geom_sf(color="black", aes(fill=Capacitacion)) +
theme_void() +
scale_fill_manual(values=Colores) +
theme(legend.title=element_blank(),
text=element_text(family="font"),
plot.title = element_blank(),
plot.subtitle = element_blank(),
legend.text = element_text(size=12, family="font")) +
guides(color = guide_legend(override.aes=list(shape = 16)))
# Grafico
Mapa_cor <- ggplot(Mapa_Salta) +
geom_sf(color="black", aes(fill=Capacitacion)) +
geom_image(data = Imagenes,
aes(x = x, y = y, image = imagen),
size = 0.05,inherit.aes = FALSE) +
theme_void() +
scale_fill_manual(values=Colores) +
theme(legend.title=element_blank(),
text=element_text(family="font"),
plot.title = element_blank(),
plot.subtitle = element_blank(),
legend.text = element_text(size=12, family="font")) +
guides(color = guide_legend(override.aes=list(shape = 16)))
# Guardar gráfico
filename <- str_sub(basename(rstudioapi::getSourceEditorContext()$path), 1,
str_length(unlist(basename(rstudioapi::getSourceEditorContext()$path)))-2)
# Guardar gr?fico
ggsave(filename=paste0(filename, ".pdf"), path=paste0(dirname(rstudioapi::getActiveDocumentContext()$path),"/Graficos/"),
plot=Mapa_cor, dpi=72, width=7, height=7)
ggsave(filename=paste0(filename, ".png"), path=paste0(dirname(rstudioapi::getActiveDocumentContext()$path),"/Graficos/PNG/"),
plot=Mapa_cor, dpi=100, width=7, height=7)
View(Imagenes)
View(Puntos)
source("C:/ESTADÍSTICA/INFORMES ANUALES/2026/Resumen ejecutivo/Presencia_capacitaciones.R", echo = TRUE)
source("C:/ESTADÍSTICA/INFORMES ANUALES/2026/Resumen ejecutivo/Presencia_capacitaciones.R", echo = TRUE)
View(Imagenes)
help("geom_image")
