# Librerías
library(ggplot2)
library(dplyr)
library(stringr)
library(cowplot)
library(magick)
library(ggtext)
library(googlesheets4)
# Fuentes
library(showtext)
font_add_google("Barlow", "font")
showtext_auto()
# Cargar datos
Raw_2024 <- read.csv(paste0(dirname(rstudioapi::getActiveDocumentContext()$path), "/Datos/Respuestas_municipios_2024.csv"))
Raw_2026 <- read.csv(paste0(dirname(rstudioapi::getActiveDocumentContext()$path), "/Datos/Respuestas_municipios_2026.csv"))
View(Raw_2024)
Data1 <- Raw_2024 %>%
select(X.Cuenta.con.espacio.físico.) %>%
rename(Variable)
Data1 <- Raw_2024 %>%
select(X.Cuenta.con.espacio.físico.) %>%
rename(Variable = "X.Cuenta.con.espacio.físico")
Data1 <- Raw_2024 %>%
select(X.Cuenta.con.espacio.físico.) %>%
rename(Variable = "X.Cuenta.con.espacio.físico.")
View(Data1)
View(Raw_2026)
Data1 <- Raw_2026 %>%
filter(X.Este.municipio.cuenta.con.Área.de.Mujeres..Géneros.y.Diversidades. == "Sí") %>%
select(X.Cuenta.con.espacio.físico.) %>%
rename(Variable = "X.Cuenta.con.espacio.físico.") %>%
group_by(Variable) %>%
summarise(Cantidad = n()) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
mutate(Variable = factor(Variable,
levels = c("Sí", "No", "No responde"))) %>%
mutate(Label = paste0("<span style='font-size:15pt'>**",
formatC(round(Porcentaje,1), big.mark=".", decimal.mark=",", format="fg"),
"%**</span><br><span style='font-size:12pt'>",
formatC(Cantidad, big.mark = ".", decimal.mark = ",", format="fg"),
"</span>")) %>%
mutate(Label = ifelse(Porcentaje >= 5, Label, "")) %>%
mutate(ymax = cumsum(Porcentaje)) %>%
mutate(ymin = c(0, head(ymax, n=-1))) %>%
rowwise() %>%
mutate(ymid = ymax - (ymax - ymin)/2) %>%
ungroup() %>%
mutate(Leyenda = ifelse(Porcentaje >= 10, as.character(Variable),
paste0(Variable, " (", formatC(round(Porcentaje,1), big.mark=".", decimal.mark = ","), "%)")))
View(Data1)
Data2 <- Raw_2024 %>%
filter(X.Este.municipio.cuenta.con.Área.de.Mujeres..Géneros.y.Diversidades. == "Sí") %>%
select(X.Cuenta.con.espacio.físico.) %>%
rename(Variable = "X.Cuenta.con.espacio.físico.") %>%
group_by(Variable) %>%
summarise(Cantidad = n()) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
mutate(Variable = factor(Variable,
levels = c("Sí", "No", "No responde"))) %>%
mutate(Label = paste0("<span style='font-size:12pt'>**",
formatC(round(Porcentaje,1), big.mark=".", decimal.mark=",", format="fg"),
"%**</span><br><span style='font-size:8pt'>",
formatC(Cantidad, big.mark = ".", decimal.mark = ",", format="fg"),
"</span>")) %>%
mutate(Label = ifelse(Porcentaje >= 5, Label, "")) %>%
mutate(ymax = cumsum(Porcentaje)) %>%
mutate(ymin = c(0, head(ymax, n=-1))) %>%
rowwise() %>%
mutate(ymid = ymax - (ymax - ymin)/2) %>%
ungroup()
View(Data2)
