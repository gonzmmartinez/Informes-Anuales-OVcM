geom_line(linewidth = 2, color="#1e7b34", lineend = "round") +
scale_x_continuous(breaks=1:30, expand=c(0, 0)) +
scale_y_continuous(expand=c(0,0), limits = c(0, 5000)) +
annotate(geom="text", y=-0, x=c(6.5, 18.5, 24.5), label=2024:2026,
size=5, color="black", family="font_title", hjust=0.5, vjust=0.5) +
geom_vline(xintercept = c(13, 25), linewidth = 1, color="darkgrey") +
coord_cartesian(ylim = c(0, 5000), xlim=c(1, 30),
clip="off", expand=FALSE) +
theme_light() +
theme(axis.text = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank(),
margins = margin(r=150, l=225, b=20))
# Layout
grafico <- plot_grid(grafico1, grafico2, ncol=1,
rel_heights = c(5,1)) +
theme(plot.background = element_rect(fill = "white", colour = NA))
