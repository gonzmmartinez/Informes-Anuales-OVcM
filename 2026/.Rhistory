# Funciones
`%ni%` = Negate(`%in%`)
# Modificar datos
Data <- Raw %>%
filter(Orientacion %ni% c("Sin dato", "")) %>%
mutate(Orientacion = ifelse(Orientacion == "Heterosexual", "Heterosexual", "Otra")) %>%
mutate(Orientacion = factor(Orientacion,
levels=c("Heterosexual", "Otra"))) %>%
group_by(Orientacion) %>%
summarise(Cantidad = n()) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
ungroup %>%
mutate(Label = ifelse(Porcentaje < 3,
paste0("<span style='font-size:10pt'>**",
formatC(round(Porcentaje,1), big.mark = ".", decimal.mark=","),
"%**</span><br><span style='font-size:7.5pt'>",
formatC(Cantidad, big.mark = ".", decimal.mark = ",","</span>")),
paste0("<span style='font-size:12.5pt'>**",
formatC(round(Porcentaje,1), big.mark = ".", decimal.mark=","),
"%**</span><br><span style='font-size:10pt'>",
formatC(Cantidad, big.mark = ".", decimal.mark = ",","</span>")))) %>%
mutate(ymax = cumsum(Porcentaje)) %>%
mutate(ymin = c(0, head(ymax, n=-1))) %>%
rowwise() %>%
mutate(ymid = ymax - (ymax - ymin)/2)
View(Data)
