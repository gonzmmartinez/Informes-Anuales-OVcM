library(ggplot2)
library(dplyr)
library(stringr)
library(cowplot)
library(magick)
library(ggtext)
library(googlesheets4)
# Fuentes
library(sysfonts)
library(showtext)
dir <- paste0(dirname(dirname(rstudioapi::getActiveDocumentContext()$path)), "/Fonts/")
dir
dir <- paste0(dirname(dirname(dirname(rstudioapi::getActiveDocumentContext()$path))), "/Fonts/")
dir
font_add(family = "font_title",
bold = file.path(dir, "CreatoDisplay-ExtraBold.otf"),
regular = file.path(dir, "CreatoDisplay-Regular.otf"))
font_add("font_subtitle", file.path(dir, "CreatoDisplay-Regular.otf"))
font_add(family = "font_body",
regular = file.path(dir, "RobotoSlab-Regular.ttf"),
bold = file.path(dir, "RobotoSlab-Bold.ttf"))
showtext_auto()
# Cargar datos
Raw_1 <- read_sheet(ss = "https://docs.google.com/spreadsheets/d/1_n2tTaEXNYTv7fGRLLXt65W49wvFmE3eDpxiBZqmMZk/edit?usp=sharing",
sheet = "REGISTRO") %>%
filter(Año == 2026)
Raw_2 <- read_sheet(ss = "https://docs.google.com/spreadsheets/d/1_n2tTaEXNYTv7fGRLLXt65W49wvFmE3eDpxiBZqmMZk/edit?usp=sharing",
sheet = "MUERTES") %>%
filter(Año == 2026)
Raw <- data.frame(Caratula = factor(c("Tienen la carátula provisoria de femicidio",
"Femicidio vinculado",
"Muertes violentas y/o dudosas que se encuentran en etapa de investigación"),
levels=c("Tienen la carátula provisoria de femicidio",
"Femicidio vinculado",
"Muertes violentas y/o dudosas que se encuentran en etapa de investigación")),
Cantidad = c(nrow(Raw_1 %>% filter(Vinculado == "FALSE")),
nrow(Raw_1 %>% filter(Vinculado == "TRUE")),
nrow(Raw_2)))
Data <- Raw %>%
filter(Cantidad != 0) %>%
mutate(Porcentaje = 100 * Cantidad / sum(Cantidad)) %>%
mutate(Label = ifelse(Porcentaje < 10,
paste0("<span style='font-size:15pt'>**",
formatC(round(Porcentaje,1), big.mark=".", decimal.mark=","),
"%**</span><br><span style='font-size:10pt'>",
formatC(Cantidad, big.mark = ".", decimal.mark = ",","</span>")),
paste0("<span style='font-size:15pt'>**",
formatC(round(Porcentaje,1), big.mark=".", decimal.mark=","),
"%**</span><br><span style='font-size:12.5pt'>",
formatC(Cantidad, big.mark = ".", decimal.mark = ",","</span>")))) %>%
mutate(ymax = cumsum(Porcentaje)) %>%
mutate(ymin = c(0, head(ymax, n=-1))) %>%
rowwise() %>%
mutate(ymid = ymax - (ymax - ymin)/2)
# Total
Total <- paste0( "<span style='font-size:25pt'>Total</span><br>",
"**", formatC(sum(Data$Cantidad), big.mark = ".", decimal.mark = ",", format = "fg"),
"**")
# Colores
Paleta <- c("#1e7b34", "#119ca0", "#b8d6ac", "#6963aa",
"#7c428a", "#4c2158", "#c72a29", "#ec6230", "#cbc2ce",
"#d6a62e", "#3f6f9f", "#b05c7a")
Colores <- c("Tienen la carátula provisoria de femicidio" = "#7c428a",
"Femicidio vinculado" = "#4c2158",
"Muertes violentas y/o dudosas que se encuentran en etapa de investigación" = "#c72a29")
# Gráfico
grafico <- ggplot(Data, aes(ymax=ymax, ymin=ymin, xmax=4, xmin=2.75, fill=Caratula)) +
geom_rect() +
geom_textbox(x = 1.5, y = 0, label = Total, hjust = 0.5,
halign = 0.5, fill = NA, size=15, box.color=NA,
family = "font_title", lineheight = 0.75) +
geom_richtext(aes(x = ifelse(Porcentaje <= 5, 4.4, 3.4), y=ymid, label=Label),
color = ifelse(Data$Porcentaje <= 5, "black", "white"),
lineheight = ifelse(Data$Porcentaje <= 5, 1.25, 1.5),
label.color = NA, family="font_body", hjust=0.5, vjust=0.5,
show.legend=FALSE, fill=NA) +
coord_polar(theta="y", start=-pi/2) +
xlim(c(1.5, 4.5)) +
theme_void() +
scale_fill_manual(values = Colores, labels = function(z) str_wrap(z, width=25)) +
theme(text=element_text(family="font_title"),
legend.position = "right",
plot.title = element_blank(),
plot.subtitle = element_blank(),
legend.title = element_blank(),
legend.text = element_text(size=15, family="font_title"),
legend.box.margin = margin(t=0,b=0,l=-50,r=60),
legend.key.spacing.y = unit(0.5, "cm"),
plot.margin = margin(t=-50, r=-50, b=-50, l=-50),
plot.background = element_rect(fill = "white", colour = NA))
